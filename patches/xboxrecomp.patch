+void recomp_eh_bind(uint32_t frame, jmp_buf *native, uint32_t lo, uint32_t hi)
+{
+    int i, w = 0;
+
+    /* Anything registered below this node belongs to frames that are gone. */
+    for (i = 0; i < s_eh_used; i++)
+        if (s_eh[i].frame > frame)
+            s_eh[w++] = s_eh[i];
+    s_eh_used = w;
+    if (s_eh_used >= RECOMP_EH_SLOTS) {
+        memmove(&s_eh[0], &s_eh[1], sizeof(s_eh[0]) * (RECOMP_EH_SLOTS - 1));
+        s_eh_used = RECOMP_EH_SLOTS - 1;
+    }
+    s_eh[s_eh_used].frame  = frame;
+    s_eh[s_eh_used].native = native;
+    s_eh[s_eh_used].lo     = lo;
+    s_eh[s_eh_used].hi     = hi;
+    s_eh_used++;
