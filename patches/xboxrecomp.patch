+/* -- Guest C++ throw decoding -----------------------------------------
+ *
+ * A raise that carries code 0xE06D7363 is an MSVC `throw`, and its record
+ * holds everything needed to name the type: parameter 1 is the exception
+ * object and parameter 2 the ThrowInfo. On x86 every pointer in that chain
+ * is an absolute guest address, so the TypeDescriptor -- and the decorated
+ * type name stored eight bytes into it -- can be read directly.
+ *
+ * Without this the log says only that something threw, which does not
+ * distinguish a bad asset from a failed allocation from a parse error.
+ */
+#define XBOX_CXX_EXCEPTION_CODE 0xE06D7363u
+#define XBOX_CXX_THROW_MAGIC    0x19930520u
+
+/* Guest reads on this path walk pointers the title supplies, any of which may
+ * be wild, so every one is bounds-checked against committed guest RAM first. */
+static int bridge_guest_readable(uint32_t va, uint32_t size)
+{
+    MEMORY_BASIC_INFORMATION mbi;
+    uintptr_t cur, end;
+
+    if (!va || size == 0)
+        return 0;
+    if (va < 0x10000u || (uint64_t)va + size > 0x08000000ull)
+        return 0;
+
+    cur = (uintptr_t)va + g_xbox_mem_offset;
+    end = cur + size;
+    while (cur < end) {
+        uintptr_t region_end;
+        if (!VirtualQuery((const void *)cur, &mbi, sizeof(mbi)))
+            return 0;
+        if (mbi.State != MEM_COMMIT)
+            return 0;
+        if (mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD))
+            return 0;
+        region_end = (uintptr_t)mbi.BaseAddress + mbi.RegionSize;
+        if (region_end <= cur)
+            return 0;
+        cur = region_end;
+    }
+    return 1;
+}
+
+static uint32_t bridge_guest_u32(uint32_t va, int *ok)
+{
+    if (!bridge_guest_readable(va, 4)) { *ok = 0; return 0; }
+    return BRIDGE_MEM32(va);
