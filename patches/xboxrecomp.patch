+    if (!throw_info)
+        return NULL;
+    catch_array = bridge_guest_u32(throw_info + 0x0C, &ok);
+    if (!ok || !catch_array)
+        return NULL;
+    count = bridge_guest_u32(catch_array, &ok);
+    if (!ok || count == 0 || count > 64)
+        return NULL;
+    catchable = bridge_guest_u32(catch_array + 4, &ok);   /* most-derived first */
+    if (!ok || !catchable)
+        return NULL;
+    type_desc = bridge_guest_u32(catchable + 4, &ok);
+    if (!ok || !type_desc)
